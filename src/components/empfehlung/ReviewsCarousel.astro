---
import reviews from '../../data/reviews.json';

interface Review {
  autor: string;
  text: string;
  sterne: number;
  datum: string;
  source?: string;
  berater?: string | null;
}

interface Props {
  beraterId?: string;
  zeigeBewertenButton?: boolean;
}

const { beraterId, zeigeBewertenButton = false } = Astro.props;

const reviewList = reviews as Review[];

// Zeige Reviews, die keinem Berater zugeordnet sind (null) ODER die exakt zum
// aufgerufenen Berater gehören. Ohne beraterId: alle Reviews sichtbar.
const filtered = reviewList.filter(
  (r) => !r.berater || !beraterId || r.berater === beraterId
);

// Duplikate-Set für nahtlosen Loop
const looped = [...filtered, ...filtered];
---

{filtered.length > 0 && (
<section class="section-surface py-16 md:py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-10 max-w-2xl mx-auto">
      <h2 class="font-display text-fluid-h2 font-semibold text-foreground mb-3">Was andere sagen.</h2>
      <p class="font-body text-base text-muted-foreground leading-relaxed">
        Verifizierte Bewertung aus unserem Google-Profil.
      </p>
      <a
        href="https://www.google.com/maps/place/DieFinanzchecker+GmbH+-+Versicherungsmakler/@51.8947206,7.5975826,931m/data=!3m1!1e3!4m8!3m7!1s0x47b9a54d88811a87:0x40de5865f81c06de!8m2!3d51.8947206!4d7.5975826!9m1!1b1!16s%2Fg%2F11mw8f0j1b?entry=ttu&g_ep=EgoyMDI2MDMxMS4wIKXMDSoASAFQAw%3D%3D"
        target="_blank"
        rel="noopener noreferrer"
        class="font-body text-sm text-muted-foreground/80 hover:text-foreground underline underline-offset-2 transition-colors mt-1 inline-block"
      >Alle Bewertungen auf Google ansehen →</a>
    </div>

    <div class="reviews-carousel relative scroll-fade-in" aria-roledescription="carousel" aria-label="Google-Bewertungen, automatisch durchlaufend">
      <div class="reviews-mask">
        <ul class="reviews-track" role="list">
          {looped.map((r, i) => (
            <li class="review-card shrink-0 rounded-lg border border-border bg-card p-6 flex flex-col" aria-hidden={i >= filtered.length ? 'true' : undefined}>
              <div class="flex gap-0.5 mb-3" aria-label={`${r.sterne} von 5 Sternen`}>
                {Array.from({ length: 5 }).map((_, j) => (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class:list={['h-4 w-4', j < r.sterne ? 'text-amber-400' : 'text-muted-foreground/30']} aria-hidden="true">
                    <path d="M12 2l2.6 7.6L22 10l-6 4.6L18 22l-6-4.5L6 22l2-7.4L2 10l7.4-.4z" />
                  </svg>
                ))}
              </div>
              <p class="font-body text-sm text-foreground leading-relaxed mb-4 flex-1">„{r.text}"</p>
              <div class="flex items-center justify-between mt-auto pt-2 border-t border-border">
                <span class="font-body text-sm font-semibold text-foreground">{r.autor}</span>
                <span class="font-body text-xs text-muted-foreground">{r.datum}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {zeigeBewertenButton && (
      <div class="flex justify-center mt-10">
        <a
          href="https://www.g.page/diefinanzchecker/review?gm"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full font-body font-semibold text-sm px-6 py-2.5 brand-gradient text-white hover:brightness-110 shimmer shadow-lg shadow-primary/20 transition-all duration-300"
        >
          Jetzt bewerten
        </a>
      </div>
    )}
  </div>
</section>
)}

<style>
  .reviews-carousel {
    --gap: 1.25rem;
    --duration: 90s;
  }
  .reviews-mask {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
  }
  .reviews-track {
    display: flex;
    gap: var(--gap);
    width: max-content;
    padding: 4px 1px 8px;
    list-style: none;
    margin: 0;
    animation: reviews-scroll var(--duration) linear infinite;
    will-change: transform;
  }
  .reviews-track:hover,
  .reviews-track:focus-within {
    animation-play-state: paused;
  }
  .review-card {
    flex: 0 0 auto;
    width: min(85vw, 340px);
  }
  @media (min-width: 640px) { .review-card { width: 320px; } }
  @media (min-width: 1024px) { .review-card { width: 360px; } }

  /* Bewegt um die Hälfte (eine volle Set-Länge), damit der Loop nahtlos ist */
  @keyframes reviews-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - (var(--gap) / 2))); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-track {
      animation: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .reviews-mask {
      -webkit-mask-image: none;
              mask-image: none;
    }
    .review-card { scroll-snap-align: start; }
  }
</style>
