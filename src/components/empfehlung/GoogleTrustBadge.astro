---
import googleTrust from '../../data/google-trust.json';

interface Props {
  id?: string;
  variant?: 'compact' | 'card';
  class?: string;
}

const { id, variant = 'compact', class: className = '' } = Astro.props;

const baseClasses = variant === 'card'
  ? 'inline-flex items-center gap-1 bg-white rounded-2xl px-2 py-1.5 shadow-md border border-border/40 font-body font-semibold text-[#0F110C]'
  : 'inline-flex items-center gap-1.5 bg-white rounded-full px-3 py-2 shadow-md text-sm font-body font-semibold text-[#0F110C] hover:shadow-lg transition-shadow';
---

<a
  id={id}
  href={googleTrust.source_url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Bewertungen auf Google ansehen — 5,0 von 5 Sternen aus über ${googleTrust.review_count} Bewertungen`}
  class:list={[baseClasses, className]}
>
  <!-- Google G Logo -->
  <svg viewBox="0 0 24 24" class:list={[variant === 'card' ? 'h-3.5 w-3.5 shrink-0' : 'h-4 w-4 shrink-0']} aria-hidden="true">
    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
  </svg>

  {variant === 'card' ? (
    <span class="flex flex-col leading-tight gap-0.5">
      <span class="flex items-center gap-1">
        <span class="flex items-center gap-0.5" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 16 16" class="h-2.5 w-2.5 fill-amber-400" aria-hidden="true">
              <path d="M8 1l1.9 3.8 4.2.6-3 2.9.7 4.2L8 10.4l-3.8 2 .7-4.2-3-2.9 4.2-.6z"/>
            </svg>
          ))}
        </span>
        <span class="text-xs font-bold">5,0</span>
      </span>
      <span class="text-[9px] font-normal text-[#5F6368]">über {googleTrust.review_count}</span>
    </span>
  ) : (
    <>
      <span class="flex items-center gap-0.5" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 16 16" class="h-3 w-3 fill-amber-400" aria-hidden="true">
            <path d="M8 1l1.9 3.8 4.2.6-3 2.9.7 4.2L8 10.4l-3.8 2 .7-4.2-3-2.9 4.2-.6z"/>
          </svg>
        ))}
      </span>
      <span class="text-xs leading-none">5,0</span>
      <span class="text-xs leading-none text-[#5F6368]">über {googleTrust.review_count}</span>
    </>
  )}
</a>
