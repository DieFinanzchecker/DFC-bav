---
// Hinweiskarte für Gesellschafter-Geschäftsführer. Die eigene Unterseite ist geplant;
// bis dahin führt die Karte zum Kontakt.
import Icon from './Icon.astro';
---

<section class="px-4 py-10 md:py-14">
  <div class="scroll-fade-in max-w-6xl mx-auto rounded-[1.75rem] border border-[#3DADFF]/25 p-8 md:p-12 flex flex-col md:flex-row md:items-center gap-8"
       style="background: linear-gradient(120deg, rgba(61,80,255,0.28), rgba(61,173,255,0.08) 60%, rgba(242,99,39,0.10));">
    <div class="flex-1">
      <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-[#3DADFF] mb-3">Für Sie persönlich</p>
      <h2 class="font-display text-3xl md:text-4xl text-white mb-3">Sie sind Gesellschafter-Geschäftsführer?</h2>
      <p class="font-body text-sm md:text-base text-white/75 max-w-2xl leading-relaxed">
        Auch für Ihre eigene Altersvorsorge bietet die bAV besondere Möglichkeiten: Vorsorge direkt über Ihre GmbH, mit steuerlichen Vorteilen und Beiträgen, die über die üblichen Grenzen hinausgehen können. Wir zeigen Ihnen, was in Ihrer Situation möglich ist.
      </p>
    </div>
    <a href="#kontakt" class="btn-primary shrink-0">
      Eigene bAV besprechen
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>
</section>
