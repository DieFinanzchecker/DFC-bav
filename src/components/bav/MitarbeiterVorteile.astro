---
import Icon from './Icon.astro';
import vorteile from '../../data/mitarbeiter-vorteile.json';

interface Vorteil {
  icon: string;
  titel: string;
  text: string;
}
const items = vorteile as Vorteil[];

// Drei Akzentfarben aus der Markenpalette, abwechselnd pro Karte — sorgt für
// spürbar mehr Farbe/Highlights in diesem sonst sehr zurückhaltenden Abschnitt.
const akzente = [
  { bg: 'rgba(61,80,255,0.2)', color: '#7B8BFF' }, // Markenblau
  { bg: 'rgba(242,99,39,0.16)', color: '#F26327' }, // Orange
  { bg: 'rgba(61,173,255,0.16)', color: '#3DADFF' }, // Hellblau
];
---

<section class="px-4 py-20 md:py-28">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="pill-label">Vorteile für Ihr Team</span>
      <h2 class="font-display text-fluid-h2 text-white mb-4">Das kommt bei Ihrem <span class="akzent">Team</span> an</h2>
      <p class="font-body text-fluid-body text-white/65">
        Auch Ihre Mitarbeitenden profitieren spürbar — ein zusätzliches Argument für die Einführung.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-5">
      {items.map((v, i) => {
        const akzent = akzente[i % akzente.length];
        return (
          <div class="benefit-card card-hover scroll-fade-in">
            <div class="benefit-icon" style={`background-color: ${akzent.bg}; color: ${akzent.color};`}>
              <Icon name={v.icon} class="h-5 w-5" />
            </div>
            <h3>{v.titel}</h3>
            <p>{v.text}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
