---
import marke from '../../data/marke.json';

// "Ohne <Marke>" vs. "Mit <Marke>" (Name aus src/data/marke.json) — B2B/bAV-Variante des bewährten
// Vergleichsmusters aus DFC-empfehlung. Bewusst NICHT die Original-Punkte übernommen
// (die drehten sich um Produktauswahl/§84 vs. §93 HGB für Privatkunden) — hier auf die
// konkrete Situation von Arbeitgebern bei der bAV zugeschnitten. Überschrift bewusst in
// Inter Bold (.b2b-heading, Sie-Ansprache, Satzform) statt Anton-Caps mit Verlaufstext,
// damit sie klar lesbar bleibt statt "verschwommen" zu wirken.

const ohne = [
  'Anbietervergleich, Vertragsverwaltung und laufende Rückfragen bleiben komplett an Ihrer HR-Abteilung hängen',
  'Bei Fehlern in der Durchführung haftet im Zweifel Ihr Unternehmen',
  'Ohne breiten Marktüberblick wird oft der erstbeste Anbieter gewählt statt der passendste',
];

const mit = [
  'Wir übernehmen Anbietervergleich, Vertragsverwaltung und die laufende Betreuung komplett für Sie',
  'Fachkundige Begleitung reduziert Ihr Haftungsrisiko und hält Sie BetrAVG-konform',
  'Breiter Marktüberblick — Sie erhalten die für Ihr Unternehmen wirklich passende Lösung',
];
---

<section class="px-4 py-20 md:py-28">
  <div class="max-w-5xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="pill-label">Der Unterschied</span>
      <h2 class="font-display text-fluid-h2 text-white mb-4">
        Was sich für Ihr Unternehmen <span class="akzent">ändert</span>
      </h2>
      <p class="font-body text-fluid-body text-muted-foreground">
        So sieht der Alltag mit betrieblicher Altersvorsorge aus — mit und ohne {marke.name} an Ihrer Seite.
      </p>
    </div>

    <div class="flex flex-col md:flex-row gap-4">
      <!-- OHNE -->
      <div
        class="flex-1 rounded-[1.25rem] p-7 md:p-9 border flex flex-col gap-4 scroll-fade-in"
        style="background: rgba(242,99,39,0.07); border-color: rgba(242,99,39,0.28);"
      >
        <p class="b2b-heading text-lg text-white mb-0">
          Ohne <span style="color: #F26327;">{marke.name}</span>
        </p>
        <div class="flex flex-col gap-3">
          {ohne.map((t) => (
            <div class="flex gap-2.5 items-start">
              <svg viewBox="0 0 20 20" fill="none" class="flex-shrink-0 mt-0.5 h-[1.1rem] w-[1.1rem]" aria-hidden="true">
                <circle cx="10" cy="10" r="10" fill="#F26327" opacity="0.2" />
                <path d="M7 7l6 6M13 7l-6 6" stroke="#F26327" stroke-width="1.8" stroke-linecap="round" />
              </svg>
              <p class="font-body text-sm leading-relaxed m-0 text-white/80">{t}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- MIT -->
      <div
        class="flex-1 rounded-[1.25rem] p-7 md:p-9 border flex flex-col gap-4 scroll-fade-in"
        style="background: linear-gradient(135deg, rgba(61,80,255,0.2), rgba(61,173,255,0.07)); border-color: rgba(61,173,255,0.35); box-shadow: 0 0 70px -30px rgba(61,120,255,0.9);"
      >
        <p class="b2b-heading text-lg text-white mb-0">
          Mit <span style="color: #3DADFF;">{marke.name}</span>
        </p>
        <div class="flex flex-col gap-3">
          {mit.map((t) => (
            <div class="flex gap-2.5 items-start">
              <svg viewBox="0 0 20 20" fill="none" class="flex-shrink-0 mt-0.5 h-[1.1rem] w-[1.1rem]" aria-hidden="true">
                <circle cx="10" cy="10" r="10" fill="#3DADFF" opacity="0.2" />
                <path d="M6 10.5l3 3 5-6" stroke="#3DADFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p class="font-body text-sm leading-relaxed m-0 text-white/80">{t}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
