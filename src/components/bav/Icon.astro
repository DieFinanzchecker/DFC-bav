---
// Gemeinsame Icon-Bibliothek für die bAV-Seite: einfache Inline-SVGs (Outline,
// 2px Stroke, aktuelle Markenfarbe via currentColor) — keine externe Icon-Library.
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'coins' && (
    <>
      <circle cx="9" cy="9" r="6" />
      <path d="M14.5 9c1.5.6 2.5 1.9 2.5 3.5 0 2.5-2.7 4.5-6 4.5-1.1 0-2.1-.2-3-.6" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3.25" />
      <path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" />
      <path d="M16 8.25a3 3 0 110 5.9" />
      <path d="M15 14.2c2.6.3 4.5 2.1 4.5 4.8" />
    </>
  )}
  {name === 'clipboard' && (
    <>
      <rect x="5.5" y="4.5" width="13" height="16" rx="2" />
      <path d="M9 4.5V4a3 3 0 016 0v.5" />
      <path d="M8.5 11h7M8.5 14.5h7M8.5 18h4" />
    </>
  )}
  {name === 'shield-check' && (
    <>
      <path d="M12 3l7 3v5.5c0 4.6-3 7.9-7 9.5-4-1.6-7-4.9-7-9.5V6z" />
      <path d="M9 12l2 2 4-4.5" />
    </>
  )}
  {name === 'layers' && (
    <>
      <path d="M12 3.5l8 4.2-8 4.2-8-4.2z" />
      <path d="M4 12.3l8 4.2 8-4.2" />
      <path d="M4 16.5l8 4.2 8-4.2" />
    </>
  )}
  {name === 'handshake' && (
    <>
      <path d="M2.5 12l4-4 3 1.5 2.5-1.5 3.5 3.5" />
      <path d="M21.5 12l-4-4-2.5 1.6" />
      <path d="M6.5 8l-4 4 4.5 4.5a2 2 0 002.9 0l.6-.6" />
      <path d="M17.5 8l4 4-4.5 4.5a2 2 0 01-2.9 0l-3-3" />
    </>
  )}
  {name === 'trending-up' && (
    <>
      <path d="M3.5 16.5l6-6 4 4 7-7.5" />
      <path d="M14.5 6.5h6v6" />
    </>
  )}
  {name === 'umbrella' && (
    <>
      <path d="M12 3a9 9 0 019 8.5H3A9 9 0 0112 3z" />
      <path d="M12 3v14.5a2.5 2.5 0 01-4.6 1.4" />
    </>
  )}
  {name === 'heart-handshake' && (
    <>
      <path d="M12 20s-6.5-4-9-8c-1.6-2.6.2-6 3.2-6 1.8 0 3.1 1 3.8 2 .7-1 2-2 3.8-2 3 0 4.8 3.4 3.2 6-1 1.6-2.6 3.2-4 4.3" />
      <path d="M6.5 12l2.5 2.5 2-2 2 2 2.5-2.5" />
    </>
  )}
  {name === 'alert-triangle' && (
    <>
      <path d="M12 4l9.5 16h-19z" />
      <path d="M12 10v4.5" />
      <circle cx="12" cy="17.3" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'scale' && (
    <>
      <path d="M12 3v18M8 21h8" />
      <path d="M5 7h14" />
      <path d="M5 7l-3 5.5a3 3 0 006 0zM19 7l-3 5.5a3 3 0 006 0z" />
    </>
  )}
  {name === 'file-search' && (
    <>
      <path d="M7 3.5h7l4 4V20a1 1 0 01-1 1H7a1 1 0 01-1-1V4.5a1 1 0 011-1z" />
      <circle cx="10.5" cy="14" r="2.3" />
      <path d="M12.2 15.7l1.8 1.8" />
    </>
  )}
  {name === 'stamp' && (
    <>
      <path d="M12 3a3 3 0 013 3c0 1.4-.9 2.1-1.6 2.8-.6.6-1 1-1 1.7h-.8c0-.7-.4-1.1-1-1.7C9.9 8.1 9 7.4 9 6a3 3 0 013-3z" />
      <path d="M6.5 15.5h11L19 20H5z" />
      <path d="M9 10.5h6l1 4.5H8z" />
    </>
  )}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7" />}
  {name === 'arrow-right' && (
    <>
      <path d="M4 12h16" />
      <path d="M14 6l6 6-6 6" />
    </>
  )}
  {name === 'chevron-down' && <path d="M6 9l6 6 6-6" />}
  {name === 'building' && (
    <>
      <rect x="5" y="3.5" width="10" height="17" rx="1" />
      <path d="M15 9h4v11.5H5" />
      <path d="M8.5 7.5h.01M11.5 7.5h.01M8.5 11h.01M11.5 11h.01M8.5 14.5h.01M11.5 14.5h.01M17.5 12.5h.01M17.5 16h.01" />
    </>
  )}
  {name === 'phone' && (
    <path d="M6 3.5c.6 1.7 1.4 3.3 2.5 4.7l-1.8 1.9a15 15 0 006.7 6.7l1.9-1.8c1.4 1 3 1.9 4.7 2.5V21c-8.6 0-15.5-6.9-15.5-15.5V3.5z" />
  )}
  {name === 'mail' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
      <path d="M4 6.5l8 6.5 8-6.5" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="4" y="5" width="16" height="15" rx="1.5" />
      <path d="M4 9.5h16M8 3v3.5M16 3v3.5" />
    </>
  )}
  {name === 'user' && (
    <>
      <circle cx="12" cy="8" r="3.5" />
      <path d="M5 20c0-3.6 3.1-6.5 7-6.5s7 2.9 7 6.5" />
    </>
  )}
</svg>
