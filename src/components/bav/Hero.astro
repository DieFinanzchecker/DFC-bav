---
import Icon from './Icon.astro';
import googleTrust from '../../data/google-trust.json';
import martinFoto from '../../assets/images/gruender/martin.avif';
import jannisFoto from '../../assets/images/gruender/jannis.avif';

const haken = [
  'Mitarbeiterbindung stärken und neue Fachkräfte gewinnen',
  'Rechtsansprüche Ihrer Mitarbeitenden sauber erfüllen',
  'Haftungsrisiken für Ihr Unternehmen minimieren',
];
---

<section class="glow-section px-4 pt-32 pb-16 md:pt-40 md:pb-24">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.15fr_1fr] gap-12 lg:gap-14 items-center">

    <div class="text-center lg:text-left">
      <span class="pill-label">Für Arbeitgeber, Geschäftsführung &amp; HR</span>
      <h1 class="font-display text-fluid-hero text-white mb-6">
        Betriebliche Altersvorsorge, die sich für Ihr Unternehmen <span class="brand-gradient-text">rechnet.</span>
      </h1>
      <p class="font-body text-fluid-body text-white/70 max-w-xl mx-auto lg:mx-0 mb-7">
        Wir versorgen Ihr gesamtes Unternehmen mit einer sauberen Betriebsrente: von der Versorgungsordnung über die Beratung Ihrer Mitarbeitenden bis zur laufenden Betreuung. <span class="text-white font-semibold">Ohne Mehraufwand</span> für Ihre HR-Abteilung.
      </p>

      <ul class="flex flex-col gap-2.5 mb-9 max-w-xl mx-auto lg:mx-0 text-left">
        {haken.map((h) => (
          <li class="flex items-start gap-3 font-body text-sm md:text-base text-white/85">
            <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#3D50FF]/25 text-[#3DADFF]">
              <Icon name="check" class="h-3 w-3" />
            </span>
            {h}
          </li>
        ))}
      </ul>

      <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
        <a href="#kontakt" class="btn-primary w-full sm:w-auto sm:whitespace-nowrap">
          Kostenloses Erstgespräch sichern
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href="#rechner" class="btn-ghost w-full sm:w-auto sm:whitespace-nowrap">Zuschuss berechnen</a>
      </div>
    </div>

    <!-- Rechte Spalte: Gründer-Doppelporträt als Glas-Karte -->
    <div class="scroll-fade-in">
      <div class="glass-card overflow-hidden max-w-md mx-auto shadow-[0_0_80px_-20px_rgba(61,80,255,0.6)]">
        <div class="grid grid-cols-2">
          <img
            src={martinFoto.src}
            width={martinFoto.width}
            height={martinFoto.height}
            decoding="async"
            alt="Martin Schmidt, Geschäftsführer DieFinanzchecker GmbH"
            class="w-full aspect-[3/4] object-cover object-top"
          />
          <img
            src={jannisFoto.src}
            width={jannisFoto.width}
            height={jannisFoto.height}
            decoding="async"
            alt="Jannis Oberhaus, Geschäftsführer DieFinanzchecker GmbH"
            class="w-full aspect-[3/4] object-cover object-top"
          />
        </div>
        <div class="px-5 py-4 text-center">
          <p class="font-body font-semibold text-white">Martin Schmidt &amp; Jannis Oberhaus</p>
          <p class="font-body text-sm text-white/60 mt-1">Ihre Ansprechpartner für die bAV in Ihrem Unternehmen</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Vertrauensleiste -->
  <div class="max-w-6xl mx-auto mt-14 md:mt-20 grid md:grid-cols-3 gap-4">
    <div class="glass-card flex items-center gap-4 px-5 py-4">
      <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#3D50FF]/20 text-[#3DADFF]">
        <Icon name="stamp" class="h-5 w-5" />
      </span>
      <p class="font-body text-sm text-white/85 leading-snug">
        <span class="font-semibold text-white">Zertifizierte Experten</span><br />
        für betriebliche Altersversorgung (DVA)
      </p>
    </div>
    <a
      href={googleTrust.source_url}
      target="_blank"
      rel="noopener noreferrer"
      class="glass-card flex items-center gap-4 px-5 py-4 hover:border-white/25 transition-colors"
    >
      <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#3D50FF]/20 text-[#3DADFF]">
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
          <path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.5l-5.9 3.2 1.2-6.6L2.5 9.5l6.6-.9z" />
        </svg>
      </span>
      <p class="font-body text-sm text-white/85 leading-snug">
        <span class="font-semibold text-white">5,0 von 5 Sternen</span><br />
        aus über {googleTrust.review_count} Google-Bewertungen
      </p>
    </a>
    <div class="glass-card flex items-center gap-4 px-5 py-4">
      <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#3D50FF]/20 text-[#3DADFF]">
        <Icon name="handshake" class="h-5 w-5" />
      </span>
      <p class="font-body text-sm text-white/85 leading-snug">
        <span class="font-semibold text-white">15+ Jahre Erfahrung</span><br />
        in der Beratung von Unternehmen und Mitarbeitenden
      </p>
    </div>
  </div>
</section>

<!-- Trigger für den Sticky-WhatsApp-Button: erscheint erst, sobald der Hero verlassen wurde -->
<div id="sticky-trigger" aria-hidden="true" class="h-px"></div>
