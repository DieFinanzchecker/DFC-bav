---
import Icon from './Icon.astro';
import faq from '../../data/faq.json';

interface FaqItem {
  frage: string;
  antwort: string;
}
const items = faq as FaqItem[];
---

<section class="section-bg px-4 py-16 md:py-24">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <span class="pill-label">Häufige Fragen</span>
      <h2 class="font-display text-fluid-h2 text-foreground mb-4">Fragen von Arbeitgebern</h2>
      <p class="font-body text-fluid-body text-muted-foreground">
        Die wichtigsten Antworten rund um betriebliche Altersvorsorge im Unternehmen.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      {items.map((item) => (
        <details class="faq-item scroll-fade-in bg-secondary/40 rounded-xl border border-border overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-5 py-4 font-body font-semibold text-sm md:text-base text-foreground">
            {item.frage}
            <Icon name="chevron-down" class="h-4 w-4 text-muted-foreground shrink-0 transition-transform duration-200" />
          </summary>
          <div class="faq-content">
            <div class="px-5 pb-5">
              <p class="font-body text-sm text-muted-foreground leading-relaxed">{item.antwort}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details.faq-item[open] summary svg {
    transform: rotate(180deg);
  }
</style>
