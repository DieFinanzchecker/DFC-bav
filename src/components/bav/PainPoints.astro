---
import Icon from './Icon.astro';

const painPoints = [
  {
    icon: 'users',
    titel: 'Fachkräftemangel',
    text: 'Gute Leute zu finden und zu halten wird schwerer — ohne überzeugende Zusatzleistungen verlieren Sie im Wettbewerb um Talente.',
  },
  {
    icon: 'scale',
    titel: 'Gesetzlicher Anspruch',
    text: 'Ihre Mitarbeitenden haben einen Rechtsanspruch auf Entgeltumwandlung. Ohne saubere Lösung müssen Sie jeden Einzelfall neu regeln.',
  },
  {
    icon: 'alert-triangle',
    titel: 'Haftungsrisiko',
    text: 'Fehler bei der Durchführung einer bAV können zu Nachforderungen und Haftungsrisiken für Ihr Unternehmen führen.',
  },
  {
    icon: 'clipboard',
    titel: 'Verwaltungsaufwand',
    text: 'Anbietervergleich, Vertragsverwaltung, laufende Pflege — ohne Unterstützung bindet das wertvolle Zeit Ihrer HR-Abteilung.',
  },
];
---

<section class="px-4 py-20 md:py-28">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="pill-label">Die Ausgangslage</span>
      <h2 class="font-display text-fluid-h2 text-white mb-4">Kommt Ihnen das <span class="akzent">bekannt</span> vor?</h2>
      <p class="font-body text-fluid-body text-white/65">
        Viele Arbeitgeber stehen beim Thema betriebliche Altersvorsorge vor denselben Herausforderungen.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {painPoints.map((p, i) => (
        <div class="glass-card card-hover scroll-fade-in flex flex-col gap-4 p-6">
          <div class="flex items-center justify-between">
            <span class="section-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="inline-flex items-center justify-center h-11 w-11 rounded-full bg-[#F26327]/15 text-[#F26327]">
              <Icon name={p.icon} class="h-5 w-5" />
            </span>
          </div>
          <h3 class="b2b-heading text-lg text-white">{p.titel}</h3>
          <p class="font-body text-sm text-white/65 leading-relaxed">{p.text}</p>
        </div>
      ))}
    </div>

    <p class="font-body text-base md:text-lg text-white font-semibold mt-12 text-center">
      Genau hier setzen wir an: mit einer bAV, die für Ihr Unternehmen funktioniert.
    </p>
  </div>
</section>
